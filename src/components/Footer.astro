---
import { themeConfig } from '@/config'
import { getLangFromPath } from '@/i18n/lang'
import { getLocalizedPath } from '@/i18n/path'

const { title } = themeConfig.site
const { links: socialLinks, startYear } = themeConfig.footer

const currentYear = new Date().getFullYear()
const year = Number(startYear) === currentYear ? startYear : `${startYear}-${currentYear}`

const currentLang = getLangFromPath(Astro.url.pathname)
const links = socialLinks.map(({ name, url, ...rest }) => {
  if (name === 'RSS') {
    return { name, url: getLocalizedPath(url, currentLang).slice(0, -1), ...rest }
  }

  if (name === 'Email') {
    return { name, url: url.startsWith('mailto:') ? url : `mailto:${url}`, ...rest }
  }

  return { name, url, ...rest }
})
---

<footer class="footer">
  <span>
    {links.map((link, index) => (
      <>
        <a href={link.url} target="_blank" rel="noopener noreferrer">{link.name}</a>
        {index < links.length - 1 && ' / '}
      </>
    ))}
  </span>
  <span>·</span>
  <span>&copy; {year} <a href={getLocalizedPath('/', currentLang)}>{title}</a></span>
  <span>·</span>
  <span>
    Powered by
    <a href="https://astro.build/" rel="noopener" target="_blank">Astro</a> &
    <a href="https://github.com/adityatelange/hugo-PaperMod/" rel="noopener" target="_blank">PaperMod</a>
  </span>
</footer>
