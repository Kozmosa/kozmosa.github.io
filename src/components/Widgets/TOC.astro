---
import type { MarkdownHeading } from 'astro'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  headings: MarkdownHeading[]
}

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

const { headings = [] } = Astro.props
const filteredHeadings = headings.filter(heading =>
  heading.depth >= 2
  && heading.depth <= 4,
)
const minDepth = Math.min(...filteredHeadings.map(heading => heading.depth))
---

{filteredHeadings.length > 0 && (
  <details class="toc" open>
    <summary accesskey="c" title="(Alt + C)">
      <span class="title">{currentUI.toc}</span>
    </summary>
    <div class="inner">
      <ul>
        {filteredHeadings.map(heading => (
          <li style={`margin-inline-start: ${(heading.depth - minDepth) * 1.25}rem`}>
            <a href={`#${heading.slug}`} aria-label={heading.text}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </details>
)}
