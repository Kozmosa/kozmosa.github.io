---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import PinIcon from '@/assets/icons/pin-icon.svg'
import PostDate from '@/components/PostDate.astro'
import { getPostPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import { getPostDescription } from '@/utils/description'

export interface Props {
  posts: Post[]
  lang: Language
  pinned?: boolean
}

const { posts, lang, pinned = false } = Astro.props
const currentUI = ui[lang as keyof typeof ui] ?? {}
---

{posts.map((post) => {
  const slug = post.data.abbrlink || post.id

  return (
    <article class="post-entry">
      <header class="entry-header">
        <h2 class="entry-hint-parent">
          <span
            transition:name={`post-${slug}${lang ? `-${lang}` : ''}`}
            data-disable-theme-transition
          >
            {post.data.title}
          </span>
          {pinned && (
            <span class="entry-hint" title={currentUI.pinned}>
              <PinIcon
                aria-hidden="true"
                class="inline-block aspect-square w-0.9em"
                fill="currentColor"
              />
            </span>
          )}
        </h2>
      </header>
      <div class="entry-content">
        <p>{getPostDescription(post, 'list')}</p>
      </div>
      <footer
        class="entry-footer"
        transition:name={`time-${slug}${lang ? `-${lang}` : ''}`}
        data-disable-theme-transition
      >
        <PostDate
          date={post.data.published}
          minutes={post.remarkPluginFrontmatter.minutes}
        />
      </footer>
      <a class="entry-link" aria-label={`post link to ${post.data.title}`} href={getPostPath(slug, lang)}></a>
    </article>
  )
})}
