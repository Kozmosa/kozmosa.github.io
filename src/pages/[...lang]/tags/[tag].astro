---
import type { Language } from '@/i18n/config'
import PostList from '@/components/PostList.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getTagPath } from '@/i18n/path'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag, getTagSupportedLangs } from '@/utils/content'

export async function getStaticPaths() {
  const paths = await Promise.all(allLocales.map(async (lang) => {
    const langTags = await getAllTags(lang)
    return langTags.map(tag => ({
      params: { lang: getLangRouteParam(lang), tag },
      props: { tag },
    }))
  }))
  return paths.flat()
}

interface Props {
  tag: string
}

const { tag } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const posts = await getPostsByTag(tag, currentLang)
const allTags = await getAllTags(currentLang)
const supportedLangs: Language[] = await getTagSupportedLangs(tag)
---

<Layout supportedLangs={supportedLangs}>
  <header class="page-header">
    <h1>#{tag}</h1>
  </header>
  <ul class="terms-tags">
    {allTags.map(tagName => (
      <li>
        <a href={getTagPath(tagName, currentLang)}>{tagName}</a>
      </li>
    ))}
  </ul>
  <div style="margin-top: var(--content-gap)">
    <PostList posts={posts} lang={currentLang} />
  </div>
</Layout>
