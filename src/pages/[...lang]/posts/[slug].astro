---
import type { CollectionEntry } from 'astro:content'
import type { Language } from '@/i18n/config'
import { getCollection, render } from 'astro:content'
import Comment from '@/components/Comment/Index.astro'
import PostDate from '@/components/PostDate.astro'
import TOC from '@/components/Widgets/TOC.astro'
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { getLocalizedPath, getPostPath, getTagPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import { checkPostSlugDuplication, getPosts } from '@/utils/content'
import { getPostDescription } from '@/utils/description'

export async function getStaticPaths() {
  const posts: CollectionEntry<'posts'>[] = await getCollection('posts')

  // Check if there are duplicate post slugs
  const duplicates = await checkPostSlugDuplication(posts)
  if (duplicates.length > 0) {
    throw new Error(`Duplicate post slugs:\n${duplicates.join('\n')}`)
  }

  // Build a map of post slugs to their supported languages
  const slugToLangsMap = new Map<string, Set<Language>>()

  for (const post of posts) {
    const slug = post.data.abbrlink || post.id
    const lang = post.data.lang

    let langSet = slugToLangsMap.get(slug)
    if (!langSet) {
      langSet = new Set()
      slugToLangsMap.set(slug, langSet)
    }

    if (lang) {
      langSet.add(lang as Language)
    }
    else {
      allLocales.forEach(locale => langSet.add(locale))
    }
  }

  const slugToLangs: Record<string, Language[]> = {}
  for (const [slug, langs] of slugToLangsMap) {
    slugToLangs[slug] = [...langs].sort((a, b) => allLocales.indexOf(a) - allLocales.indexOf(b))
  }

  return allLocales.flatMap(lang => posts
    // Show drafts in dev mode only
    .filter(post => import.meta.env.DEV || !post.data.draft)
    // Match current language or universal posts
    .filter(post => post.data.lang === lang || post.data.lang === '')
    .map((post) => {
      const slug = post.data.abbrlink || post.id
      return {
        params: { lang: getLangRouteParam(lang), slug },
        props: { post, supportedLangs: slugToLangs[slug] },
      }
    }),
  )
}

interface Props {
  post: CollectionEntry<'posts'>
  supportedLangs: Language[]
}

const { post, supportedLangs } = Astro.props
const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const slug = post.data.abbrlink || post.id
const description = getPostDescription(post, 'meta')
const { Content, headings, remarkPluginFrontmatter } = await render(post)

// Adjacent posts for the prev/next navigation (posts are sorted newest first)
const allPosts = await getPosts(currentLang)
const currentIndex = allPosts.findIndex(p => (p.data.abbrlink || p.id) === slug)
const prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null
const nextPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null
---

<Layout
  postTitle={post.data.title}
  postDescription={description}
  postSlug={post.id}
  supportedLangs={supportedLangs}
>
  <article class="post-single">
    <header class="post-header">
      <nav class="breadcrumbs" aria-label="breadcrumb">
        <a href={getLocalizedPath('/', currentLang)}>{currentUI.home}</a>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        <a href={getLocalizedPath('/posts/', currentLang)}>{currentUI.posts}</a>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        <span>{post.data.title}</span>
      </nav>
      <h1 class="post-title">
        <span
          transition:name={`post-${slug}${currentLang ? `-${currentLang}` : ''}`}
          data-disable-theme-transition
        >
          {post.data.title}
        </span>
      </h1>
      {post.data.description && (
        <div class="post-description">
          {post.data.description}
        </div>
      )}
      <div
        class="post-meta"
        transition:name={`time-${slug}${currentLang ? `-${currentLang}` : ''}`}
        data-disable-theme-transition
      >
        <PostDate
          date={post.data.published}
          updatedDate={post.data.updated}
          minutes={remarkPluginFrontmatter.minutes}
        />
      </div>
    </header>

    {post.data.toc && <TOC headings={headings} />}

    <div class="post-content md-content">
      <Content />
    </div>

    <footer class="post-footer">
      {post.data.tags?.length > 0 && (
        <ul class="post-tags">
          {post.data.tags.map((tag: string) => (
            <li><a href={getTagPath(tag, currentLang)}>{tag}</a></li>
          ))}
        </ul>
      )}
      {(prevPost || nextPost) && (
        <nav class="paginav">
          {prevPost && (
            <a class="prev" href={getPostPath(prevPost.data.abbrlink || prevPost.id, currentLang)}>
              <span class="title">« {currentUI.prevPost}</span>
              <span>{prevPost.data.title}</span>
            </a>
          )}
          {nextPost && (
            <a class="next" href={getPostPath(nextPost.data.abbrlink || nextPost.id, currentLang)}>
              <span class="title">{currentUI.nextPost} »</span>
              <span>{nextPost.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </footer>

    <Comment />
  </article>
</Layout>
