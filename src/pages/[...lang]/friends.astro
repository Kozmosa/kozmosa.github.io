---
import { allLocales } from '@/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

// Friend links — add your friends here
const friends = [
  { name: 'Example', url: 'https://example.com', desc: currentLang === 'zh' ? '一个示例站点' : 'An example site' },
]
---

<Layout>
  <header class="page-header">
    <h1>{currentUI.friends}</h1>
  </header>
  <div class="md-content">
    <ul>
      {friends.map(f => (
        <li>
          <a href={f.url} target="_blank" rel="noopener noreferrer">{f.name}</a>
          {' — '}{f.desc}
        </li>
      ))}
    </ul>
  </div>
</Layout>
